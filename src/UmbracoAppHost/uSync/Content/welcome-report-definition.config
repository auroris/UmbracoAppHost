<?xml version="1.0" encoding="utf-8"?><Content Key="cb890760-860f-f8aa-7bfc-d463589e7f38" Alias="Recently changed pages report" Level="2">
  <Info>
    <Parent Key="dc3f9857-8628-c80c-fe4a-0e6d4a249318">Data sources</Parent>
    <Path>/DataSources/Recentlychangedpagesreport</Path>
    <Trashed>false</Trashed>
    <ContentType>reportDefinition</ContentType>
    <CreateDate>2026-10-24T12:00:00</CreateDate>
    <NodeName Default="Recently changed pages report"/>
    <SortOrder>2</SortOrder>
    <Published Default="true"/>
    <Schedule/>
    <Template/>
  </Info>
  <Properties><alias><Value><![CDATA[umbraco-recent-pages]]></Value></alias><title><Value><![CDATA[Recently changed pages]]></Value></title><connection><Value><![CDATA[UmbracoDb]]></Value></connection><sql><Value><![CDATA[SELECT LOWER(CAST(n.uniqueId AS VARCHAR(36))) AS PAGE_KEY, n.id AS PAGE_ID, v.text AS NAME, {ContentPath} AS PATH, COALESCE(NULLIF(u.userName, ''), u.userLogin, 'Unknown user') AS EDITED_BY, {EditedAt} AS EDITED_AT, v.versionDate AS VERSION_DATE FROM umbracoNode n JOIN umbracoDocument d ON d.nodeId = n.id JOIN umbracoContentVersion v ON v.nodeId = n.id AND v."current" = 1 LEFT JOIN umbracoUser u ON u.id = v.userId WHERE n.trashed = 0 AND {{RowRestriction}}]]></Value></sql><options><Value><![CDATA[{
  "defaultPageSize": 10,
  "columnLabels": {
    "PAGE_KEY": "Key",
    "PAGE_ID": "Id",
    "NAME": "Page name",
    "PATH": "Path",
    "EDITED_BY": "Edited by",
    "EDITED_AT": "Edited when",
    "VERSION_DATE": "Save time (full precision)"
  },
  "columns": {
    "PATH": {
      "helpText": "The full content tree path, including this page."
    },
    "EDITED_AT": {
      "helpText": "When the latest version was saved, including unpublished changes."
    }
  },
  "editLink": {
    "urlTemplate": "/umbraco/section/content/workspace/document/edit/{PAGE_KEY}",
    "label": "Edit page",
    "target": "_self"
  },
  "authorization": {
    "policy": "UmbracoBackOfficeContentReports"
  },
  "defaultState": {
    "page": {
      "index": 1,
      "size": 10
    },
    "activeTable": "pages",
    "tables": {
      "pages": {
        "from": "definition",
        "composables": [
          {
            "kind": "select",
            "columns": [
              "NAME",
              "PATH",
              "EDITED_BY",
              "EDITED_AT"
            ]
          },
          {
            "kind": "sort",
            "sorts": [
              {
                "col": "VERSION_DATE",
                "dir": "desc"
              },
              {
                "col": "PAGE_ID",
                "dir": "desc"
              }
            ]
          },
          {
            "kind": "formats",
            "formats": {
              "EDITED_AT": {
                "mask": "yyyy-mm-dd hh:mm:ss"
              }
            }
          }
        ]
      }
    }
  }
}]]></Value></options></Properties>
</Content>