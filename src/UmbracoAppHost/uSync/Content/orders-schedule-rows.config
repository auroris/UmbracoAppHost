    <source>
      <Value><![CDATA[SELECT CUSTOMER AS "KEY", CUSTOMER AS LABEL, MIN(REGION) AS "GROUP"
FROM ORDERS
WHERE ORDER_ID <= 48
GROUP BY CUSTOMER]]></Value>
    </source>
