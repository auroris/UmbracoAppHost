      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Content blocks and field properties"
        },
        {
          "alias": "formInterface",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "517b713a-a066-2a47-386d-d6adb77f96ca",
