        }
      ]
    },
    {
      "contentTypeKey": "70eed87e-49ff-37f0-8e95-4312473fb492",
      "key": "3f724f9d-06ae-250c-6dde-ca904beda99c",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EContent blocks sit in a form beside its fields. \u003Cstrong\u003ERich text\u003C/strong\u003E such as this paragraph takes the theme\u0027s typography; \u003Cstrong\u003EHTML\u003C/strong\u003E, \u003Cstrong\u003ECSS\u003C/strong\u003E and \u003Cstrong\u003EJavaScript\u003C/strong\u003E blocks hold code written in the backoffice.\u003C/p\u003E\u003Cul\u003E\u003Cli\u003ECSS goes into the page\u0027s head once, however many blocks carry it: both regions below carry the same stylesheet.\u003C/li\u003E\u003Cli\u003EJavaScript runs at the end of the page, after the shell\u0027s own scripts.\u003C/li\u003E\u003Cli\u003EField blocks can be hidden, start a new record with a default value, take a width of the twelve-column grid, and show a placeholder.\u003C/li\u003E\u003C/ul\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "97ae0a05-a71b-33c3-114e-6c8d6388cd2a",
      "key": "a9337b5d-0f64-420e-4ed9-1e0659bb81ff",
      "values": [
        {
          "alias": "html",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u003Cdiv class=\u0022content-demo-callout\u0022\u003E\n  \u003Cp\u003E\u003Cstrong\u003ERaw HTML.\u003C/strong\u003E This box is markup from an HTML block. A CSS block gives it the border, and a JavaScript block keeps the time: \u003Ctime data-content-demo-clock\u003E--:--:--\u003C/time\u003E.\u003C/p\u003E\n\u003C/div\u003E"
        }
      ]
    },
    {
      "contentTypeKey": "4eaf7d7f-96ca-e772-9471-f745267d3634",
      "key": "49768773-3c46-afbf-4f50-dc221307e97e",
      "values": [
        {
          "alias": "css",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ".content-demo-callout {\n  padding: 0.75rem 1rem;\n  border-left: 4px solid currentColor;\n  background: rgba(127, 127, 127, 0.08);\n}\n\n.content-demo-callout \u003E :last-child {\n  margin-bottom: 0;\n}"
        }
      ]
    },
    {
      "contentTypeKey": "7ea55d43-703d-b91f-9e28-7addfe9e29b2",
      "key": "b448b350-dc6f-e832-5014-6dfbccaaaf5c",
      "values": [
        {
          "alias": "script",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "document.querySelectorAll(\u0022[data-content-demo-clock]\u0022).forEach(function (clock) {\n  function tick() {\n    clock.textContent = new Date().toLocaleTimeString();\n  }\n  tick();\n  setInterval(tick, 1000);\n});"
        }
      ]
    },
    {
      "contentTypeKey": "f329406c-e9f8-f43b-d1a2-0f24c10ce078",
      "key": "d65d336b-35be-9dd7-1f5d-a9ff171a5a67",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "HTML, CSS and JavaScript"
        }
      ]
    },
    {
      "contentTypeKey": "97ae0a05-a71b-33c3-114e-6c8d6388cd2a",
      "key": "aead8d61-94c5-1c26-d039-34eba2af7788",
      "values": [
        {
          "alias": "html",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u003Cdiv class=\u0022content-demo-callout\u0022\u003E\n  \u003Cp\u003ECustomer starts as your username (\u003Ccode\u003E:USER_NAME\u003C/code\u003E) and Notes as the address\u0027s \u003Ccode\u003Enote\u003C/code\u003E parameter (\u003Ccode\u003E:PARAM.note\u003C/code\u003E): open \u003Ca href=\u0022?note=Rush\u0022\u003Ethis page with ?note=Rush\u003C/a\u003E. Status is hidden but saved with the order, and the widths lay the fields out in two rows.\u003C/p\u003E\n\u003C/div\u003E"
        }
      ]
    },
    {
      "contentTypeKey": "4eaf7d7f-96ca-e772-9471-f745267d3634",
