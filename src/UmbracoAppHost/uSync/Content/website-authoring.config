    <css>
      <Value>.website-authoring-intro { padding: 1rem; border-left: .25rem solid #3545a8; background: #f4f5fa; margin-bottom: 1.5rem; }
[data-guide-finder] input { display: block; width: 100%; max-width: 28rem; margin: .5rem 0 1rem; padding: .5rem; }</Value>
    </css>
    <javascript>
      <Value>document.querySelectorAll('[data-guide-finder]').forEach(finder =&gt; {
  const input = finder.querySelector('input');
  const rows = [...finder.querySelectorAll('li')];
  input.addEventListener('input', () =&gt; {
    const query = input.value.trim().toLocaleLowerCase();
    rows.forEach(row =&gt; row.hidden = !row.textContent.toLocaleLowerCase().includes(query));
    const count = rows.filter(row =&gt; !row.hidden).length;
    finder.querySelector('[data-guide-count]').textContent = `${count} guide${count === 1 ? '' : 's'}`;
  });
});</Value>
    </javascript>
