  <Properties>
    <title>
      <Value Culture="en">Application overview and support</Value>
    </title>
    <applicationBlocks>
      <Value Culture="en">{
  "contentData": [
    {
      "contentTypeKey": "97ae0a05-a71b-33c3-114e-6c8d6388cd2a",
      "key": "4c807a06-3639-1059-8ab6-a2d4d1f0c692",
      "values": [
        {
          "alias": "html",
          "culture": null,
          "segment": null,
          "value": "&lt;div class=\"website-authoring-intro\"&gt;&lt;p&gt;A public page can explain an application, link to its documentation, and tell people where to get help. Put the working application under a nested Web Site using the Application site template, and configure Public Access on that branch.&lt;/p&gt;&lt;/div&gt;"
        }
      ]
    },
    {
      "contentTypeKey": "c2d2b5b1-43e9-f471-b583-f03f83a6c8da",
      "key": "0eca8788-e5c9-7a71-6146-bc8728fd1fd5",
      "values": []
    },
    {
      "contentTypeKey": "97ae0a05-a71b-33c3-114e-6c8d6388cd2a",
      "key": "9f17d166-7787-8594-747a-d14387d4254a",
      "values": [
        {
          "alias": "html",
          "culture": null,
          "segment": null,
          "value": "&lt;section&gt;&lt;h2&gt;Support&lt;/h2&gt;&lt;p&gt;Use this space for your support team, contact details, service hours, and help links.&lt;/p&gt;&lt;p&gt;This page inherits the site navigation and visual identity. Its content and page code are authored here.&lt;/p&gt;&lt;/section&gt;"
        }
      ]
    },
    {
      "contentTypeKey": "97ae0a05-a71b-33c3-114e-6c8d6388cd2a",
      "key": "c4dffa90-bcb0-d8bb-d2b3-a4e340a139f7",
      "values": [
        {
          "alias": "html",
          "culture": null,
          "segment": null,
          "value": "&lt;section data-guide-finder&gt;&lt;h2&gt;Documentation&lt;/h2&gt;&lt;label for=\"guide-filter\"&gt;Find a guide&lt;/label&gt;&lt;input id=\"guide-filter\" type=\"search\" placeholder=\"Type a word\"&gt;&lt;ul&gt;&lt;li&gt;Getting started&lt;/li&gt;&lt;li&gt;Working with records&lt;/li&gt;&lt;li&gt;Printing a report&lt;/li&gt;&lt;/ul&gt;&lt;p aria-live=\"polite\" data-guide-count&gt;3 guides&lt;/p&gt;&lt;/section&gt;"
        }
      ]
    }
  ],
