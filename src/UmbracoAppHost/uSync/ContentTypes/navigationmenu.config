    <GenericProperty>
      <Key>bed1c391-8001-4990-89dc-a48e02fb3b3a</Key>
      <Name>Profile page</Name>
      <Alias>profilePage</Alias>
      <Definition>fd1e0da5-5606-4862-b679-5d0cf3a52a59</Definition>
      <Type>Umbraco.ContentPicker</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description>The page a menu entry linking to {{user.profile}} opens for a signed-in member. Leave empty to inherit the nearest ancestor's choice; without one, such entries stay hidden.</Description>
      <SortOrder>3</SortOrder>
      <Tab Alias="navigation">Navigation</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
