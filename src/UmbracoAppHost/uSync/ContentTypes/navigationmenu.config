  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>46e3b803-2ad4-553b-13e6-1a7c3b09fcb1</Key>
      <Name>Top navigation menu</Name>
      <Alias>topNavigationMenu</Alias>
      <Definition>f2086ae7-3ef2-3a47-0261-d90618ff1658</Definition>
      <Type>Umbraco.Community.UmbNav</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description>Leave empty to inherit the nearest ancestor menu. Descendants inherit this menu unless another composition owner supplies one. Labels and link addresses may use {{user.name}}, {{user.username}}, {{user.email}}, {{user.profile}}, {{user.backoffice}} and {{user.signout}}; an entry whose token has no value for the visitor is hidden.</Description>
      <SortOrder>2</SortOrder>
      <Tab Alias="navigation">Navigation</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
