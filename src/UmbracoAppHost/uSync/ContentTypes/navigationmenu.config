<ContentType Key="c96e842c-1e71-61ce-bf3a-422ad2c7ad16" Alias="navigationMenu" Level="2">
  <Info>
    <Name>Navigation Menu</Name>
    <Icon>icon-settings</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>A reusable navigation menu composition. Compose onto any document type that should define a menu.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <Folder>Website</Folder>
