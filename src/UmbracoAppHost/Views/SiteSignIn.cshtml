@inherits UmbracoViewPage
@inject UmbracoAppHost.Themes.SiteThemeCatalog Themes
@{
    Layout = (await Themes.ResolveForAsync(Model, NavigationQueryService, PublishedStatusFilteringService, TemplateService)).PageLayout;
    PageAssets.RegisterPage(Model, NavigationQueryService, PublishedStatusFilteringService, Context);
    ViewData["MemberAccessOnly"] = true;
}
<partial name="Website/Content" />
<section class="app-signin">
    <partial name="App/SignIn" />
</section>
