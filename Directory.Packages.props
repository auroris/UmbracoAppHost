    <PackageVersion Include="Umbraco.Cms" Version="18.3.0" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="18.3.0" />
    <PackageVersion Include="Umbraco.Community.UmbNav" Version="5.0.3" />
    <PackageVersion Include="uSync" Version="18.2.0" />
  </ItemGroup>
</Project>
